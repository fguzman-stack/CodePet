    <!-- Bug Hunt -->
    <string name="bug_codey">Codey: %1$s</string>
    <string name="bug_initial">¡Encuentra el bug antes de que el compilador explote!</string>
    <string name="bug_wrong_line">¡Esa línea está bien! Sigue buscando...</string>
    <string name="bug_next_round">¡Siguiente ronda! ¿Dónde se esconde el bug?</string>
    <string name="bug_score">Acertaste %1$d de %2$d</string>
    <string name="bug_explanation">Explicación: %1$s</string>
    <string name="bug_expl_1">Falta el paréntesis de cierre en println.</string>
    <string name="bug_humor_1">¡Era un paréntesis fugitivo! Se escapó sin pagar el alquiler.</string>
    <string name="bug_expl_2">En Kotlin la comparación es == no =. = es asignación.</string>
    <string name="bug_humor_2">Codey: ¡Un solo = es asignación, doble == es comparación! No confundas al compilador.</string>
    <string name="bug_expl_3">Falta el tipo de retorno explícito, debería ser \': Int\'.</string>
    <string name="bug_humor_3">Codey: Hasta una calculadora de bolsillo sabe qué va a devolver.</string>
    <string name="bug_expl_4">En Kotlin el for usa paréntesis: for (i in nums).</string>
    <string name="bug_humor_4">Codey: ¡Los paréntesis no son decoración! Son parte de la sintaxis.</string>
    <string name="bug_expl_5">main no necesita paréntesis vacíos si es la entrada.</string>
    <string name="bug_humor_5">Codey: En realidad main() está bien, ¡pero este bug es tramposo!</string>
    <string name="bug_expl_6">Está decrementando count en vez de incrementarlo. Bucle infinito.</string>
    <string name="bug_humor_6">Codey: ¡Así nunca llegarás a 5! Es como correr hacia atrás.</string>
    <string name="bug_expl_7">No se puede asignar un String directamente a Int. Usa toInt().</string>
    <string name="bug_humor_7">Codey: ¡No puedes convertir strings a Int por ósmosis! Usa .toInt().</string>
    <string name="bug_expl_8">La función debe declarar tipo de retorno: fun isEven(n: Int): Boolean.</string>
    <string name="bug_humor_8">Codey: El compilador no es adivino. Dile qué vas a devolver.</string>
    <string name="bug_expl_9">listOf crea una lista inmutable. Usa mutableListOf.</string>
    <string name="bug_humor_9">Codey: ¡No puedes modificar una lista inmutable! Es como intentar cambiar el pasado.</string>
    <string name="bug_expl_10">Líneas vacías innecesarias. El código debe ser limpio.</string>
    <string name="bug_humor_10">Codey: ¿Estás escribiendo código o una novela? Muy poético pero poco práctico.</string>

    <!-- Git Rescue -->
    <string name="git_initial">¡Rápido, el repo está en llamas!</string>
    <string name="git_wrong">¡Esa no era la mejor opción!</string>
    <string name="git_next">¡Siguiente decisión! El repo te necesita.</string>
    <string name="git_decisions">Decisiones correctas: %1$d de %2$d</string>
    <string name="git_progress">Progreso de la rama:</string>
    <string name="git_step">Paso %1$d de %2$d</string>
    <string name="git_sit_1">Acabas de clonar el repo y vas a trabajar en un nuevo feature. ¿Qué haces primero?</string>
    <string name="git_opt_1a">git checkout -b feature/nuevo</string>
    <string name="git_opt_1b">git commit -m \"inicio\"</string>
    <string name="git_opt_1c">git push --force</string>
    <string name="git_expl_1">Crear una rama nueva desde main es la forma correcta de empezar un feature.</string>
    <string name="git_humor_1">Codey: ¡Nunca pushes a main sin antes crear una rama! Eres un cowboy.</string>
    <string name="git_sit_2">Has hecho cambios locales y te das cuenta de que rompiste todo. Quieres volver al último commit limpio.</string>
    <string name="git_opt_2a">git reset --hard HEAD</string>
    <string name="git_opt_2b">git revert HEAD</string>
    <string name="git_opt_2c">git rm -rf .</string>
    <string name="git_expl_2">revert crea un nuevo commit que deshace los cambios, preservando la historia.</string>
    <string name="git_humor_2">Codey: reset --hard es como una máquina del tiempo sin frenos. revert es más seguro.</string>
    <string name="git_sit_3">Tienes un conflicto en un merge. ¿Cuál es el siguiente paso?</string>
    <string name="git_opt_3a">Resolver el conflicto en el editor y luego git add</string>
    <string name="git_opt_3b">git commit --amend</string>
    <string name="git_opt_3c">git push --force origin main</string>
    <string name="git_expl_3">Los conflictos se resuelven editando los archivos, luego git add y git commit.</string>
    <string name="git_humor_3">Codey: push --force no resuelve conflictos, los empeora. Es como echar gasolina al fuego.</string>
    <string name="git_sit_4">Trabajas en equipo y necesitas traerte los cambios más recientes de la rama main a tu rama feature.</string>
    <string name="git_opt_4a">git pull origin main</string>
    <string name="git_opt_4b">git merge feature main</string>
    <string name="git_opt_4c">git branch -d main</string>
    <string name="git_expl_4">git pull trae los cambios de main a tu rama actual. merge lo haría al revés.</string>
    <string name="git_humor_4">Codey: No borres main. Nunca borres main. Es como borrar el diccionario.</string>
    <string name="git_sit_5">Hiciste un commit pero olvidaste incluir un archivo. ¿Cómo lo arreglas?</string>
    <string name="git_opt_5a">git add archivo &amp;&amp; git commit --amend</string>
    <string name="git_opt_5b">git reset --hard HEAD~1</string>
    <string name="git_opt_5c">git commit --allow-empty</string>
    <string name="git_expl_5">Con amend puedes agregar archivos al commit anterior sin crear uno nuevo.</string>
    <string name="git_humor_5">Codey: --allow-empty no arregla nada. Es como poner un post-it en una puerta cerrada.</string>
    <string name="git_sit_6">Quieres ver qué archivos modificaste antes de hacer commit. ¿Qué comando usas?</string>
    <string name="git_opt_6a">git diff</string>
    <string name="git_opt_6b">git status</string>
    <string name="git_opt_6c">git show</string>
    <string name="git_expl_6">git status muestra el estado actual: archivos modificados, nuevos y eliminados.</string>
    <string name="git_humor_6">Codey: diff es para ver el contenido exacto, status te da el resumen. Dos herramientas diferentes.</string>
    <string name="git_sit_7">El historial de commits está lleno de mensajes como \'fix\' y \'update\'. Quieres limpiarlo antes de hacer merge.</string>
    <string name="git_opt_7a">git rebase -i HEAD~5</string>
    <string name="git_opt_7b">git reset --hard origin/main</string>
    <string name="git_opt_7c">git commit --fixup</string>
    <string name="git_expl_7">rebase interactivo te permite squash, reordenar y renombrar commits.</string>
    <string name="git_humor_7">Codey: Los mensajes \'fix\' y \'update\' son como decir \'cosa\' en un examen. Sé descriptivo.</string>
    <string name="git_sit_8">Tu rama feature quedó atrás de main y necesitas actualizarla sin crear commits de merge.</string>
    <string name="git_opt_8a">git rebase main</string>
    <string name="git_opt_8b">git merge main</string>
    <string name="git_opt_8c">git pull --rebase</string>
    <string name="git_expl_8">pull --rebase trae cambios y los aplica encima de tus commits locales.</string>
    <string name="git_humor_8">Codey: El histórico lineal es como una carretera recta. Los merges son rotondas.</string>

