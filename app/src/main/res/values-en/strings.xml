    <!-- Bug Hunt -->
    <string name="bug_codey">Codey: %1$s</string>
    <string name="bug_initial">Find the bug before the compiler blows up!</string>
    <string name="bug_wrong_line">That line is fine! Keep looking...</string>
    <string name="bug_next_round">Next round! Where is the bug hiding?</string>
    <string name="bug_score">You got %1$d of %2$d</string>
    <string name="bug_explanation">Explanation: %1$s</string>
    <string name="bug_expl_1">The closing parenthesis is missing in println.</string>
    <string name="bug_humor_1">It was a fugitive parenthesis! It escaped without paying rent.</string>
    <string name="bug_expl_2">In Kotlin comparison is ==, not =. = is assignment.</string>
    <string name="bug_humor_2">Codey: One = is assignment, double == is comparison! Don\'t confuse the compiler.</string>
    <string name="bug_expl_3">The explicit return type is missing, it should be \': Int\'.</string>
    <string name="bug_humor_3">Codey: Even a pocket calculator knows what it\'s going to return.</string>
    <string name="bug_expl_4">In Kotlin, for uses parentheses: for (i in nums).</string>
    <string name="bug_humor_4">Codey: Parentheses aren\'t decoration! They\'re part of the syntax.</string>
    <string name="bug_expl_5">main doesn\'t need empty parentheses if it\'s the entry point.</string>
    <string name="bug_humor_5">Codey: Actually main() is fine, but this bug is a cheater!</string>
    <string name="bug_expl_6">It\'s decrementing count instead of incrementing it. Infinite loop.</string>
    <string name="bug_humor_6">Codey: You\'ll never reach 5 that way! It\'s like running backwards.</string>
    <string name="bug_expl_7">You can\'t assign a String directly to an Int. Use toInt().</string>
    <string name="bug_humor_7">Codey: You can\'t convert strings to Int by osmosis! Use .toInt().</string>
    <string name="bug_expl_8">The function must declare a return type: fun isEven(n: Int): Boolean.</string>
    <string name="bug_humor_8">Codey: The compiler isn\'t a fortune teller. Tell it what you\'re returning.</string>
    <string name="bug_expl_9">listOf creates an immutable list. Use mutableListOf.</string>
    <string name="bug_humor_9">Codey: You can\'t modify an immutable list! That\'s like trying to change the past.</string>
    <string name="bug_expl_10">Unnecessary blank lines. Code should be clean.</string>
    <string name="bug_humor_10">Codey: Are you writing code or a novel? Very poetic, not very practical.</string>

    <!-- Git Rescue -->
    <string name="git_initial">Quick, the repo is on fire!</string>
    <string name="git_wrong">That wasn\'t the best option!</string>
    <string name="git_next">Next decision! The repo needs you.</string>
    <string name="git_decisions">Correct decisions: %1$d of %2$d</string>
    <string name="git_progress">Branch progress:</string>
    <string name="git_step">Step %1$d of %2$d</string>
    <string name="git_sit_1">You just cloned the repo and are about to work on a new feature. What do you do first?</string>
    <string name="git_opt_1a">git checkout -b feature/new</string>
    <string name="git_opt_1b">git commit -m \"start\"</string>
    <string name="git_opt_1c">git push --force</string>
    <string name="git_expl_1">Creating a new branch from main is the right way to start a feature.</string>
    <string name="git_humor_1">Codey: Never push to main without creating a branch first! You cowboy.</string>
    <string name="git_sit_2">You made local changes and realize you broke everything. You want to go back to the last clean commit.</string>
    <string name="git_opt_2a">git reset --hard HEAD</string>
    <string name="git_opt_2b">git revert HEAD</string>
    <string name="git_opt_2c">git rm -rf .</string>
    <string name="git_expl_2">revert creates a new commit that undoes changes, preserving history.</string>
    <string name="git_humor_2">Codey: reset --hard is a time machine without brakes. revert is safer.</string>
    <string name="git_sit_3">You have a merge conflict. What\'s the next step?</string>
    <string name="git_opt_3a">Resolve the conflict in the editor, then git add</string>
    <string name="git_opt_3b">git commit --amend</string>
    <string name="git_opt_3c">git push --force origin main</string>
    <string name="git_expl_3">Conflicts are resolved by editing the files, then git add and git commit.</string>
    <string name="git_humor_3">Codey: push --force doesn\'t resolve conflicts, it makes them worse. Like throwing gasoline on fire.</string>
    <string name="git_sit_4">You\'re working in a team and need to bring the latest changes from main into your feature branch.</string>
    <string name="git_opt_4a">git pull origin main</string>
    <string name="git_opt_4b">git merge feature main</string>
    <string name="git_opt_4c">git branch -d main</string>
    <string name="git_expl_4">git pull brings main\'s changes into your current branch. merge would do it the other way around.</string>
    <string name="git_humor_4">Codey: Don\'t delete main. Never delete main. It\'s like deleting the dictionary.</string>
    <string name="git_sit_5">You committed but forgot to include a file. How do you fix it?</string>
    <string name="git_opt_5a">git add file &amp;&amp; git commit --amend</string>
    <string name="git_opt_5b">git reset --hard HEAD~1</string>
    <string name="git_opt_5c">git commit --allow-empty</string>
    <string name="git_expl_5">With amend you can add files to the previous commit without creating a new one.</string>
    <string name="git_humor_5">Codey: --allow-empty fixes nothing. It\'s like putting a post-it on a closed door.</string>
    <string name="git_sit_6">You want to see which files you modified before committing. Which command do you use?</string>
    <string name="git_opt_6a">git diff</string>
    <string name="git_opt_6b">git status</string>
    <string name="git_opt_6c">git show</string>
    <string name="git_expl_6">git status shows the current state: modified, new and deleted files.</string>
    <string name="git_humor_6">Codey: diff shows the exact content, status gives you the summary. Two different tools.</string>
    <string name="git_sit_7">The commit history is full of messages like \'fix\' and \'update\'. You want to clean it up before merging.</string>
    <string name="git_opt_7a">git rebase -i HEAD~5</string>
    <string name="git_opt_7b">git reset --hard origin/main</string>
    <string name="git_opt_7c">git commit --fixup</string>
    <string name="git_expl_7">Interactive rebase lets you squash, reorder and rename commits.</string>
    <string name="git_humor_7">Codey: \'fix\' and \'update\' messages are like writing \'thing\' on an exam. Be descriptive.</string>
    <string name="git_sit_8">Your feature branch fell behind main and you need to update it without creating merge commits.</string>
    <string name="git_opt_8a">git rebase main</string>
    <string name="git_opt_8b">git merge main</string>
    <string name="git_opt_8c">git pull --rebase</string>
    <string name="git_expl_8">pull --rebase fetches changes and applies them on top of your local commits.</string>
    <string name="git_humor_8">Codey: Linear history is like a straight highway. Merges are roundabouts.</string>

