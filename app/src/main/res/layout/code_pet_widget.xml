<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_background">

    <!-- Header: name + level badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/default_pet_name"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_badge"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:textColor="#FFD700"
            android:textSize="9sp"
            android:textStyle="bold"
            tools:text="Nv.1" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/widget_status_happy"
        android:textColor="#9BA3B2"
        android:textSize="9sp" />

    <!-- Codey: takes every spare pixel so the pet is always the protagonist -->
    <ImageView
        android:id="@+id/widget_pet_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="44dp"
        android:adjustViewBounds="false"
        android:contentDescription="@string/cd_widget_pet"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_codey_logo" />

    <!-- Health -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/meter_health"
            android:textColor="#B7C2D9"
            android:textSize="8sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/health_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_bar_health"
            tools:progress="80" />

        <TextView
            android:id="@+id/health_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF8FA3"
            android:textSize="8sp"
            tools:text="80%" />
    </LinearLayout>

    <!-- Energy -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/meter_energy"
            android:textColor="#B7C2D9"
            android:textSize="8sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/energy_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_bar_energy"
            tools:progress="65" />

        <TextView
            android:id="@+id/energy_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B7C2D9"
            android:textSize="8sp"
            tools:text="65%" />
    </LinearLayout>

    <!-- Hunger -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_hunger"
            android:textColor="#B7C2D9"
            android:textSize="8sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/hunger_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:max="100"
            android:progressDrawable="@drawable/progress_bar_hunger"
            tools:progress="45" />

        <TextView
            android:id="@+id/hunger_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B7C2D9"
            android:textSize="8sp"
            tools:text="45%" />
    </LinearLayout>

    <!-- Footer: bytes + streak -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_bytes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFD700"
            android:textSize="9sp"
            tools:text="50 bytes" />

        <TextView
            android:id="@+id/widget_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9BA3B2"
            android:textSize="9sp"
            tools:text="Racha: 0 días" />
    </LinearLayout>

</LinearLayout>
